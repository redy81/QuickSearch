<Window x:Class="QuickSearch.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickSearch"
        mc:Ignorable="d"
        Title="AboutWindow" Height="150" Width="200" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="QuickSearch"/>
            <Separator Height="4" Visibility="Hidden"/>
            <TextBlock Name="VersionText" HorizontalAlignment="Center" d:Text="Version 1.0"/>
            <Separator Height="16"/>
            <TextBlock HorizontalAlignment="Center" Text="Filippo Branchetti - 2026"/>
        </StackPanel>
    </Grid>
</Window>
