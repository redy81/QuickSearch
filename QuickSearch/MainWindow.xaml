<Window x:Class="QuickSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickSearch"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="700" MinHeight="300" MinWidth="500">

    <Window.DataContext>
        <local:MainWindowVM/>
    </Window.DataContext>
    
    <Window.Resources>
        <local:BooleanNot x:Key="BoolNot"/>
    </Window.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <Button Width="120" Height="32" Margin="4" Content="Search" Command="{Binding StartCmd}" IsEnabled="{Binding IsRunning,Converter={StaticResource BoolNot}}"/>
            <Button Width="120" Height="32" Margin="4" Content="Stop" Command="{Binding StopCmd}" IsEnabled="{Binding IsRunning}"/>
            <Button Width="96" Height="24" Margin="4" Content="Clear data" Command="{Binding ClearCmd}" IsEnabled="{Binding IsRunning,Converter={StaticResource BoolNot}}"/>
            <Button Width="96" Height="24" Margin="4" DockPanel.Dock="Right" Content="About" Command="{Binding AboutCmd}"/>
        </DockPanel>

        <GroupBox Grid.Row="1" Margin="4" IsEnabled="{Binding IsRunning,Converter={StaticResource BoolNot}}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search Options" VerticalAlignment="Center"/>
                    <Image Source="/Icons/info1.png" Height="12" RenderOptions.BitmapScalingMode="HighQuality" Margin="4 0 0 0" Opacity="0.5"
                           ToolTip="{Binding SearchTooltip}"/>
                </StackPanel>
            </GroupBox.Header>

            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="4 4 4 0" Text="Path:"/>
                <DockPanel Grid.Row="1">
                    <Button DockPanel.Dock="Right" Margin="0 4 4 4" Width="48" Content="Select" Command="{Binding OpenFolderCmd}"/>
                    <TextBox Margin="4" Height="22" DockPanel.Dock="Right" Text="{Binding StartPath}"/>
                </DockPanel>
                <TextBlock Grid.Row="2" Margin="4 4 4 0" Text="Search Text:"/>
                <TextBox Grid.Row="3" Margin="4" Height="22" Text="{Binding SearchString}"/>
                <WrapPanel Grid.Row="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Match type" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox Margin="0 4 4 4" Width="90" ToolTip="{Binding MatchToolTip}" SelectedIndex="{Binding MatchType}">
                            <ComboBoxItem>Simple</ComboBoxItem>
                            <ComboBoxItem>Wildcards</ComboBoxItem>
                            <ComboBoxItem>RegEx</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox Content="Ignore subfolders" Margin="8 4" VerticalAlignment="Center" IsChecked="{Binding DoNotSearchSubfolders}"/>
                    <CheckBox Content="Case sensitive" Margin="8 4" VerticalAlignment="Center" IsChecked="{Binding IsCaseSensitive}"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Margin="4">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search results" VerticalAlignment="Center"/>
                    <Image Source="/Icons/info1.png" Height="12" RenderOptions.BitmapScalingMode="HighQuality" Margin="4 0 0 0" Opacity="0.5"
                           ToolTip="{Binding SearchResultTooltip}"/>
                </StackPanel>
            </GroupBox.Header>
            <Grid Margin="4">
                <DataGrid Margin="4" ItemsSource="{Binding SearchResults}" 
                          Name="FilesDataGrid"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          HorizontalGridLinesBrush="LightGray"
                          VerticalGridLinesBrush="LightGray"
                          CanUserSortColumns="{Binding IsRunning,Converter={StaticResource BoolNot}}"
                          d:ItemsSource="{d:SampleData}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FullName}"/>
                        <DataGridTextColumn Header="Ext" Binding="{Binding Extension}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}"/>
                    </DataGrid.Columns>
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding DoubleClickCmd}"
                                      CommandParameter="{Binding ElementName=FilesDataGrid,Path=SelectedItem}"/>
                    </DataGrid.InputBindings>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="4" Height="24" Margin="-4">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem>
                <TextBlock d:Text="Test" Text="{Binding StatusLeft}"/>
            </StatusBarItem>

            <Separator Grid.Column="1"/>

            <StatusBarItem Grid.Column="2">
                <TextBlock d:Text="Test" Text="{Binding StatusCenter}"/>
            </StatusBarItem>

            <Separator Grid.Column="3"/>

            <StatusBarItem Grid.Column="4">
                <ProgressBar Width="92" Height="16" Margin="0" IsIndeterminate="{Binding IsRunning}"/>
            </StatusBarItem>

        </StatusBar>
    </Grid>
</Window>
